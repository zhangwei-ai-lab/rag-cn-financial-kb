# ===== 方式一：本地 Ollama（推荐，零费用）=====
LLM_BACKEND=ollama
EMBEDDING_BACKEND=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_THINK=0
ANSWER_MODEL=qwen3-8b-local:latest
RERANK_MODEL=qwen3-8b-local:latest
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024

# MinerU 云端解析（可选）
MINERU_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MINERU_OCR=0
MINERU_LANGUAGE=ch

